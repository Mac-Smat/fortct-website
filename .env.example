# Copy this file to .env and fill values (do NOT commit your real .env)
# Get these from the Supabase dashboard: Project Settings > API
# Only the safe client-side values are used — never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base path for deployment (set in Vercel Dashboard > Settings > Environment Variables)
# Leave empty or '/' for root domain (your-app.vercel.app/)
# Set to '/subpath' only if deploying to a subpath.
BASE_URL=/

# ---------------------------------------------------------------------------
# Server-side secrets (set in Supabase Dashboard > Edge Functions > social-highlights,
# NOT in this .env — they never reach the browser)
# ---------------------------------------------------------------------------
# Instagram Graph API (Business/Creator account linked to a Meta app):
#   INSTAGRAM_ACCESS_TOKEN — long-lived token with instagram_business_basic scope
# TikTok Display API (app approved for video.list scope):
#   TIKTOK_ACCESS_TOKEN    — user access token with video.list scope
# Google Business Profile reviews (edge function google-reviews):
# Official Google Business Profile API v4.9 — free to use (no billing), but
# access must be approved by Google (request via the GBP API access form) and
# the listing must be verified. OAuth replaces API keys entirely:
#   GOOGLE_OAUTH_CLIENT_ID     — OAuth client ID (Desktop app) from Google Cloud
#                                Console > APIs & Services > Credentials
#   GOOGLE_OAUTH_CLIENT_SECRET — matching client secret
#   GOOGLE_REFRESH_TOKEN       — one-time consent token for the account that
#                                owns/manages the listing (scope
#                                https://www.googleapis.com/auth/business.manage)
#   GOOGLE_BUSINESS_NAME       — optional; listing name used to auto-resolve the
#                                location (default "FortCT Ltd")
# Set all in Supabase Dashboard > Edge Functions > google-reviews, NOT here.

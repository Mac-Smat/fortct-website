# Copy this file to .env and fill values (do NOT commit your real .env)
# Get these from the Supabase dashboard: Project Settings > API
# Only the safe client-side values are used — never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Server-side secrets (set in Supabase Dashboard > Edge Functions > social-highlights,
# NOT in this .env — they never reach the browser)
# ---------------------------------------------------------------------------
# Instagram Graph API (Business/Creator account linked to a Meta app):
#   INSTAGRAM_ACCESS_TOKEN — long-lived token with instagram_business_basic scope
# TikTok Display API (app with Display API approval):
#   TIKTOK_CLIENT_KEY      — app client key
#   TIKTOK_CLIENT_SECRET   — app client secret
#   TIKTOK_ACCESS_TOKEN    — user access token (videos:read / user.data.basic)
# Google Business Profile reviews (edge function google-reviews):
#   GOOGLE_PLACE_ID        — Places ID of the business (the ChIJ... string in a
#                            Maps place URL, or from the Places IDs tool)
#   GOOGLE_MAPS_API_KEY    — API key with "Places API (New)" enabled in Google
#                            Cloud Console.
#                            IMPORTANT: the key is used server-side by the edge
#                            function, so do NOT add an "HTTP referrers" (website)
#                            restriction — there is no Referer header on server
#                            calls and Google will reject them. Restrict the key
#                            under "API restrictions" to Places API (New) only,
#                            and cap it with a quota/budget alert instead.
# Set both in Supabase Dashboard > Edge Functions > google-reviews, NOT here.
